# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string. Production: a managed Postgres (e.g. Neon, Supabase) with ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dealan"
# Connection used for migrations. Locally the same as DATABASE_URL. With Supabase on Vercel:
#   DATABASE_URL = transaction pooler (port 6543) + "?pgbouncer=true&connection_limit=1"
#   DIRECT_URL   = session pooler (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/dealan"
# Session encryption key. Generate with: npx auth secret   (use a different one in production)
AUTH_SECRET="generate-with-npx-auth-secret"

# ── Property data (address lookups) ─────────────────────────────────────────
# RentCast key (free tier: 50 calls/month, 3 per new address). Leave empty to turn lookups off.
RENTCAST_API_KEY=""
# Use synthetic data for every lookup (local development only).
# PROPERTY_DATA_PROVIDER="demo"
# Paid lookups allowed per user in 30 days, and for the whole site per calendar month.
# Cached addresses (30 days) and demo visitors never count. Keep the monthly cap under your RentCast plan.
LOOKUP_USER_LIMIT="10"
LOOKUP_MONTHLY_LIMIT="45"

# Address shown on the Privacy Policy and Terms for privacy and account requests.
CONTACT_EMAIL=""

# ── Optional ────────────────────────────────────────────────────────────────
# Address autocomplete beyond the free Photon service.
GEOAPIFY_API_KEY=""
# Street View photos on deals.
GOOGLE_MAPS_API_KEY=""
# Map tiles. tile.openstreetmap.org is fine for development but its usage policy doesn't allow
# production apps — set a provider URL (MapTiler, Stadia Maps, Thunderforest…) before launch.
# NEXT_PUBLIC_MAP_TILE_URL="https://tiles.example.com/{z}/{x}/{y}.png?key=YOUR_KEY"
# NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; Provider &copy; OpenStreetMap contributors"
# Google Analytics 4 measurement ID (production only).
# NEXT_PUBLIC_GA_ID="G-XXXXXXX"
# Google Ads conversion tracking: account tag ID and one conversion label per event.
# NEXT_PUBLIC_GOOGLE_ADS_ID="AW-XXXXXXXXX"
# NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=""
# NEXT_PUBLIC_GOOGLE_ADS_FIRST_DEAL_LABEL=""
